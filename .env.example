# Supabase project URL — found in Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key — safe to expose in browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — NEVER expose this in the browser
# Only used in server actions and API routes
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Your deployed site URL — used for auth redirects
# In development: http://localhost:3000
# In production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel & GitHub Tokens
VERCEL_PROJECT_ID=your-vercel-project-id
VERCEL_API_TOKEN=your-vercel-api-token
GITHUB_TOKEN=your-github-token

# Playwright Bug Reporter Access (For raising tickets in tests)
PLAYWRIGHT_BUG_REPORTER_ACCESS_ID=your-bug-reporter-id
PLAYWRIGHT_BUG_REPORTER_PASSWORD=your-bug-reporter-password

# Backblaze B2 Credentials (PDF / Document Reports)
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=your-b2-bucket-name
B2_DOWNLOAD_URL=https://f005.backblazeb2.com/file/your-bucket-name

# Backblaze B2 Credentials for Images
B2_IMAGES_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_IMAGES_REGION=us-east-005
B2_IMAGES_KEY_ID=your-b2-images-key-id
B2_IMAGES_APPLICATION_KEY=your-b2-images-application-key
B2_IMAGES_BUCKET_NAME=your-b2-images-bucket-name

# ConvertAPI Secret
CONVERTAPI_SECRET=your-convertapi-secret

# Brevo Email API Key
BREVO_API_KEY=your-brevo-api-key
